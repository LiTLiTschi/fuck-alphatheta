/* Main TUI Styles */

/* Global */
Screen {
    background: $surface;
    align: center middle;
}

/* Header */
Header {
    dock: top;
    height: 3;
    background: $primary;
    color: $text;
}

/* Footer */
Footer {
    dock: bottom;
    height: 1;
    background: $panel;
}

/* Main Container */
#main-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

/* Menu */
#menu {
    width: 50;
    height: auto;
    background: $panel;
    border: solid $primary;
    padding: 2 4;
}

#title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#subtitle {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}

#spacer,  #spacer2 {
    height: 1;
}

/* Buttons */
Button {
    width: 100%;
    margin: 0 0 1 0;
    min-height: 3;
}

Button.-primary {
    background: $primary-darken-2;
}

Button.-primary:hover {
    background: $primary;
}

Button.-primary:focus {
    background: $primary;
}

Button.-error {
    background: $error-darken-2;
}

Button.-error:hover {
    background: $error;
}

/* DataTable (for future screens) */
DataTable {
    height: 1fr;
    border: solid $primary;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
}

DataTable > .datatable--header {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Screen Containers */
#settings-container,
#monitors-container,
#shapes-container,
#test-container,
#presets-container {
    width: 100%;
    height: 100%;
    padding: 2;
}

#screen-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $primary;
    margin-bottom: 2;
    padding: 1;
    background: $panel;
}

/* Settings List */
#settings-list {
    border: solid $primary;
    padding: 2;
    margin-bottom: 2;
    height: auto;
}

#settings-list > Static {
    margin-bottom: 1;
}

/* Test Options */
#test-options {
    border: solid $primary;
    padding: 2;
    width: 60;
    height: auto;
    align: center middle;
}

#test-options > Button {
    margin-bottom: 1;
}

/* Actions Row */
#actions {
    height: auto;
    align: center middle;
    padding: 1;
}

#actions > Button {
    margin: 0 1;
}

/* Active Preset Info */
#active-preset {
    padding: 1;
    margin-bottom: 1;
    background: $panel;
    border: solid $primary;
    content-align: center middle;
}

/* Update Notification Banner */
#update-banner {
    width: 100%;
    padding: 1 2;
    margin-bottom: 2;
    content-align: center middle;
    background: $warning;
    color: #000000;
    text-style: bold;
}

#update-banner.hidden {
    display: none;
}

#update-banner.update-available {
    background: $warning;
    color: #000000;
}

/* Updates Section */
#updates-spacer {
    height: 1;
}

#updates-title {
    width: 100%;
    content-align: left middle;
    text-style: bold;
    color: $primary;
    margin-top: 2;
    margin-bottom: 1;
}

#updates-section {
    border: solid $primary;
    padding: 2;
    margin-bottom: 2;
    height: auto;
}

#updates-section > Static {
    margin-bottom: 1;
}

/* Color Scheme */
$primary: #00d9ff;
$primary-darken-1: #00a8cc;
$primary-darken-2: #007799;
$success: #00ff00;
$warning: #ffff00;
$error: #ff0000;
$error-darken-1: #cc0000;
$error-darken-2: #990000;
$surface: #0e0e0e;
$panel: #1a1a1a;
$text: #ffffff;
$text-muted: #888888;
