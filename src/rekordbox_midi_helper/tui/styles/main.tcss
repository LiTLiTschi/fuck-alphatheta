/* Main TUI Styles */

/* Global */
Screen {
    background: $surface;
    align: center middle;
}

/* Header */
Header {
    dock: top;
    height: 3;
    background: $primary;
    color: $text;
}

/* Footer */
Footer {
    dock: bottom;
    height: 1;
    background: $panel;
}

/* Main Container */
#main-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

/* Menu */
#menu {
    width: 50;
    height: auto;
    background: $panel;
    border: solid $primary;
    padding: 2 4;
}

#title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#subtitle {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}

#spacer,  #spacer2 {
    height: 1;
}

/* Buttons */
Button {
    width: 100%;
    margin: 0 0 1 0;
    min-height: 3;
}

Button.-primary {
    background: $primary-darken-2;
}

Button.-primary:hover {
    background: $primary;
}

Button.-primary:focus {
    background: $primary;
}

Button.-error {
    background: $error-darken-2;
}

Button.-error:hover {
    background: $error;
}

/* DataTable (for future screens) */
DataTable {
    height: 1fr;
    border: solid $primary;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
}

DataTable > .datatable--header {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Color Scheme */
$primary: #00d9ff;
$primary-darken-1: #00a8cc;
$primary-darken-2: #007799;
$success: #00ff00;
$warning: #ffff00;
$error: #ff0000;
$error-darken-1: #cc0000;
$error-darken-2: #990000;
$surface: #0e0e0e;
$panel: #1a1a1a;
$text: #ffffff;
$text-muted: #888888;
